name: exception_type
description: "exception_type is a Dart package that provides a structured way to handle failures and errors in Flutter applications. It includes predefined authentication, database, API, and network failure messages, along with utility functions to map failures to user-friendly messages."
version: 0.0.6
homepage: https://github.com/GenieCoderSrc/exception_type
repository: https://github.com/GenieCoderSrc/exception_type
issue_tracker: https://github.com/GenieCoderSrc/exception_type/issues

environment:
  sdk: \x27>=3.6.0 <4.0.0\x27

    flutter: ">=3.0.0"
